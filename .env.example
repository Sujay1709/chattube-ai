# ==========================================================================
#  Copy this file to .env.local and fill in real values.
#  .env.local is gitignored — real keys belong there, NOT in this template.
# ==========================================================================

# ---- Option A: OpenRouter (free models for chat AND embeddings) ----
# Get a key at https://openrouter.ai/keys (starts with sk-or-...)
OPENAI_API_KEY=sk-or-your-openrouter-key
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# "openrouter/free" auto-picks a currently-available free chat model.
# Or pick a specific free slug from https://openrouter.ai/models?max_price=0
CHAT_MODEL=openrouter/free
# Free embedding model on OpenRouter (verify current slug on the models page)
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# Optional: shown in OpenRouter's dashboard
APP_URL=http://localhost:3000

# ---- Transcript provider (REQUIRED for production / Vercel) ----
# YouTube blocks caption scraping from datacenter IPs, so on Vercel you need a
# transcript API. Get a free key at https://supadata.ai (100 transcripts/month).
# Leave blank for local dev — the free scraper is used automatically.
SUPADATA_API_KEY=

# ---- Option B: OpenAI directly ----
# Leave OPENAI_BASE_URL unset (or delete it) and use an OpenAI key instead:
# OPENAI_API_KEY=sk-proj-...
# CHAT_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
